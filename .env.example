# Copy to .secrets.env (setup_env.sh does this for you) and `source .secrets.env` before a run.
# Never commit the filled-in file.

# Required: every paper setting runs through OpenRouter.
OPENROUTER_API_KEY=

# Optional: only for configs with `provider: azure` (a direct Azure OpenAI deployment).
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
